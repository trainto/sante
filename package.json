{
  "name": "@trainto/sante",
  "version": "0.4.0",
  "author": {
    "name": "Hakjoon Sim",
    "email": "trainto@gmail.com",
    "url": "https://heyjoon.dev"
  },
  "license": "MIT",
  "description": "Tiny and simple React state management library",
  "keywords": [
    "react",
    "state",
    "management",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/trainto/sante.git"
  },
  "bugs": {
    "url": "https://github.com/trainto/sante/issues"
  },
  "type": "module",
  "main": "dist/sante.umd.cjs",
  "module": "dist/sante.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/sante.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/sante.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-cjs-types.mjs",
    "deploy": "pnpm build && npm publish --access public",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "check:package": "node scripts/check-package.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "immer": "^10.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0"
  }
}
